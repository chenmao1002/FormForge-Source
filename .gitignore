# Source roots are explicit; unknown top-level output stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/pyproject.toml
!/tsconfig.json
!/requirements*.txt
!/requirements-cam.lock
!/启动FormForge*.cmd
!/src/
!/web/
!/scripts/
!/desktop/
!/procurement-browser/
!/vendor/
!/standards/
!/docs/
!/tests/

# Only reviewed provenance and functional standards belong here.
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/brick90-assembled.png
!/docs/images/brick90-exploded.png
!/docs/images/brick90-demo.gif
!/docs/images/gamepad-assembled.png
!/docs/images/gamepad-exploded.png
!/docs/images/schematic-workspace.png
!/docs/images/usb-rs422-pcb.png
!/docs/images/gamepad-pcb.png
!/docs/images/fan-assembly.png
!/docs/images/handheld-assembly.png
!/docs/images/firmware-workspace.png
!/docs/videos/
/docs/videos/*
!/docs/videos/brick90-design-demo.mp4
!/docs/migrations/
/docs/migrations/*
!/docs/migrations/M3-parser.json
!/docs/migrations/M4-routing-kernels.json
!/docs/migrations/M4-1021C-body-gap.json
!/docs/migrations/M4-1021C-readability.json
!/docs/migrations/M5-mechanical-engine.json
!/docs/migrations/M6-cmsis.json
!/docs/migrations/M6-firmware-kernel.json
!/docs/migrations/M6-stm32-cmsis.json
/standards/*
!/standards/mechanical/
!/standards/pcb-manufacturing/

# Credentials, private workspace, dependencies and generated output at any depth.
**/data/
**/.local/
**/.cache/
**/.venv*/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/dist/
**/web/assets/
**/.env
**/.env.*
**/*.pyc
**/*.db
**/*.sqlite*
**/*.dpapi
**/*.har
**/*.log
**/*.map
**/*.zip
**/*.exe
**/*.pem
**/*.key
**/api-token.txt
**/storage-state*.json
**/storageState*.json
**/session-info.json
**/session.dpapi
**/browser-profile*/
**/user-data*/
**/profile/
**/profiles/
**/sessions/
**/Cookies
**/Login Data
**/Web Data
**/History
**/Local State
**/Default/
**/.DS_Store
**/Thumbs.db
